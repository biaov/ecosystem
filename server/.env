# 服务配置
VITE_PORT=3600 # 服务端口

# 数据库配置
VITE_DB_HOST=127.0.0.1 # 数据库主机地址
VITE_DB_NAME=ecosystem-shop # 数据库名称
VITE_DB_PORT=3306 # 数据库端口
VITE_DB_USERNAME=root # 数据库用户名
VITE_DB_PASSWORD=123456 # 数据库密码
VITE_DB_SYNC=true # 同步表;开发环境可开启, 正式环境应关闭
VITE_DB_PREFIX=eco_ # 数据库表前缀

# Redis 配置
VITE_REDIS_HOST=127.0.0.1 # Redis 主机地址
VITE_REDIS_PROT=6379 # Redis 端口
VITE_REDIS_PASSWORD=123456 # Redis 密码

# jwt 配置
VITE_JWT_SECRET=secret # jwt 密钥

# 静态资源前缀
VITE_ASSETS_BASEURL=http://127.0.0.1:3600/server/ # 静态资源前缀

# 邮箱配置
VITE_EMAIL_USER= # 邮箱账号
VITE_EMAIL_AUTH_CODE= # 邮箱授权码-POP3/IMAP/SMTP/Exchange/CardDAV 服务
VITE_EMAIL_HOST=smtp.qq.com # 默认为 QQ 邮箱
VITE_EMAIL_PORT=465 # 邮箱端口
